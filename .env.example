POSTGRES_USER=tgcapi
POSTGRES_PASSWORD=tgcapi
POSTGRES_DB=tgcapi
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tgcapi:tgcapi@localhost:5432/tgcapi?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Bearer token guarding /admin and the server-to-server /track/bot/* endpoints
# (the welcome bot must send it as Authorization: Bearer <ADMIN_TOKEN>).
ADMIN_TOKEN=openssl rand -hex 8

PORT=3000

# @username of the welcome bot (without @). Used to build the deep link returned
# by /track/click: https://t.me/<WELCOME_BOT_USERNAME>?start=<clickId>
WELCOME_BOT_USERNAME=
